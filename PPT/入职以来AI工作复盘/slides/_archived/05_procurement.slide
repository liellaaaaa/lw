<Slide style={{ width:'1280px', height:'720px', position:'relative', background:'#FFFFFF', fontFamily:'微软雅黑' }}>
  <Box style={{ position:'absolute', left:56, top:36, flexDirection:'row', alignItems:'center', gap:12 }}>
    <Box style={{ width:8, height:34, background:'#4472C4' }} />
    <Text style={{ fontSize:30, fontWeight:'bold', color:'#052B7C' }}>采购分析助手（ProcurementAnalysis）</Text>
  </Box>

  <Box style={{ position:'absolute', left:56, top:140, right:56, flexDirection:'row', gap:36 }}>
    <Box style={{ width:420, flexDirection:'column', gap:18 }}>
      <Box style={{ background:'#F4F7FC', borderRadius:10, padding:'18px 22px' }}>
        <Text style={{ fontSize:60, fontWeight:'bold', color:'#4472C4' }}>15,227</Text>
        <Text style={{ fontSize:16, color:'#1A1A1A', marginTop:4 }}>条价格数据（基准价 5,673 + 报价 9,554）</Text>
      </Box>
      <Box style={{ flexDirection:'row', gap:18 }}>
        <Box style={{ flex:1, background:'#F4F7FC', borderRadius:10, padding:'16px 18px', alignItems:'center' }}>
          <Text style={{ fontSize:44, fontWeight:'bold', color:'#052B7C' }}>61</Text>
          <Text style={{ fontSize:15, color:'#1A1A1A', marginTop:2 }}>覆盖品类</Text>
        </Box>
        <Box style={{ flex:1, background:'#F4F7FC', borderRadius:10, padding:'16px 18px', alignItems:'center' }}>
          <Text style={{ fontSize:44, fontWeight:'bold', color:'#052B7C' }}>7</Text>
          <Text style={{ fontSize:15, color:'#1A1A1A', marginTop:2 }}>功能模块</Text>
        </Box>
      </Box>
      <Text style={{ fontSize:16, color:'#1A1A1A' }}>交付周期 <span style={{ fontWeight:'bold', color:'#4472C4' }}>29 天</span>（04-30 → 05-29 移交采购部）</Text>
    </Box>

    <Box style={{ flex:1, flexDirection:'column', gap:14, justifyContent:'center' }}>
      <Text style={{ fontSize:18, fontWeight:'bold', color:'#052B7C' }}>痛点</Text>
      <Text style={{ fontSize:17, color:'#1A1A1A', lineHeight:1.6 }}>采购原料价格波动大、品类多（61 个），原靠人工盯盘 + Excel，价格异常往往事后才发现，供应商比价缺系统支撑。</Text>
      <Text style={{ fontSize:18, fontWeight:'bold', color:'#052B7C', marginTop:6 }}>价值</Text>
      <Text style={{ fontSize:17, color:'#1A1A1A', lineHeight:1.6 }}>15,227 条数据 + 7 模块把价格监控系统化——看板看趋势、预警推异常、供应商看板横向比价；6 月架构重构后查询更快更稳，让「拍脑袋比价」变「看数据决策」。</Text>
      <Text style={{ fontSize:17, color:'#1A1A1A', marginTop:4 }}>主要对象：<span style={{ fontWeight:'bold' }}>采购部</span></Text>
    </Box>
  </Box>

  <Box style={{ position:'absolute', left:56, top:668, right:56, flexDirection:'row', justifyContent:'space-between' }}>
    <Text style={{ fontSize:14, color:'#888' }}>入职以来 AI 工作复盘</Text>
    <Text style={{ fontSize:14, color:'#888' }}>05 / 13</Text>
  </Box>
</Slide>
